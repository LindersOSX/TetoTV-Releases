<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

<androidx.media3.ui.PlayerView
    android:id="@+id/tetotv_player_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:focusable="true"
    android:focusableInTouchMode="true"
    app:animation_enabled="false"
    app:auto_show="false"
    app:controller_layout_id="@layout/tetotv_player_controls"
    app:hide_on_touch="true"
    app:show_fastforward_button="true"
    app:show_next_button="false"
    app:show_previous_button="false"
    app:show_rewind_button="true"
    app:show_subtitle_button="false"
    app:show_timeout="5000"
    app:surface_type="surface_view"
    app:time_bar_scrubbing_enabled="false"
    app:use_controller="true" />

<Button
    android:id="@+id/tetotv_skip_segment"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="end|bottom"
    android:layout_marginEnd="38dp"
    android:layout_marginBottom="184dp"
    android:background="@drawable/tetotv_skip_button_background"
    android:drawableStart="@drawable/tetotv_ic_skip_next"
    android:drawablePadding="8dp"
    android:ellipsize="end"
    android:focusable="true"
    android:fontFamily="sans-serif-black"
    android:gravity="center"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:minHeight="44dp"
    android:minWidth="0dp"
    android:nextFocusDown="@id/exo_play_pause"
    android:nextFocusLeft="@id/exo_play_pause"
    android:nextFocusRight="@id/exo_play_pause"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="11dp"
    android:paddingBottom="11dp"
    android:text="@string/tetotv_player_skip_intro"
    android:textAllCaps="false"
    android:textColor="@android:color/white"
    android:textSize="14sp"
    android:textStyle="bold"
    android:visibility="gone" />

</FrameLayout>
