<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <View
        android:id="@id/exo_controls_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/tetotv_player_controls_scrim" />

    <TextView
        android:id="@+id/tetotv_paused_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="34dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="34dp"
        android:ellipsize="end"
        android:fontFamily="sans"
        android:maxLines="1"
        android:shadowColor="#FF000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="12"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!--
        Media3 owns a native SurfaceView, so it cannot render Flutter's
        TetoPlayerChrome. Keep this hierarchy in the same semantic order and
        on the same spacing grid as the shared MPV/VLC chrome.
    -->
    <LinearLayout
        android:id="@id/exo_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/tetotv_player_card_background"
        android:clipChildren="false"
        android:elevation="10dp"
        android:layoutDirection="ltr"
        android:outlineProvider="background"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tetotv_controller_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/tetotv_engine_label"
                style="@style/TetoTVPlayerBadge"
                android:layout_marginStart="12dp"
                android:text="@string/tetotv_player_media3" />

            <TextView
                android:id="@+id/tetotv_stream_label"
                style="@style/TetoTVPlayerBadge"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxWidth="190dp"
                android:maxLines="1"
                android:text="@string/tetotv_player_debrid_stream" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/tetotv_player_controls_scroll"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:fillViewport="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:clipChildren="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@id/exo_center_controls"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:clipChildren="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/tetotv_rewind_control"
                        style="@style/TetoTVPlayerControlPill"
                        android:layout_width="40dp"
                        android:addStatesFromChildren="true"
                        android:gravity="center"
                        android:paddingEnd="0dp">

                        <ImageButton
                            android:id="@id/exo_rew"
                            style="@style/TetoTVPlayerControlIcon"
                            android:layout_width="40dp"
                            android:contentDescription="@string/tetotv_player_rewind"
                            android:nextFocusLeft="@id/tetotv_skip_segment"
                            android:nextFocusRight="@id/exo_play_pause"
                            android:paddingStart="11dp"
                            android:paddingEnd="11dp"
                            android:src="@drawable/tetotv_ic_replay_rounded" />
                    </LinearLayout>

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:id="@+id/tetotv_play_pause_control"
                        style="@style/TetoTVPlayerControlPill.Primary"
                        android:layout_width="40dp"
                        android:addStatesFromChildren="true"
                        android:gravity="center"
                        android:paddingEnd="0dp">

                        <ImageButton
                            android:id="@id/exo_play_pause"
                            style="@style/TetoTVPlayerControlIcon"
                            android:layout_width="40dp"
                            android:contentDescription="@string/tetotv_player_play"
                            android:nextFocusLeft="@id/exo_rew"
                            android:nextFocusRight="@id/exo_ffwd"
                            android:paddingStart="11dp"
                            android:paddingEnd="11dp"
                            android:src="@drawable/tetotv_ic_play_arrow_rounded" />
                    </LinearLayout>

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:id="@+id/tetotv_fast_forward_control"
                        style="@style/TetoTVPlayerControlPill"
                        android:layout_width="40dp"
                        android:addStatesFromChildren="true"
                        android:gravity="center"
                        android:paddingEnd="0dp">

                        <ImageButton
                            android:id="@id/exo_ffwd"
                            style="@style/TetoTVPlayerControlIcon"
                            android:layout_width="40dp"
                            android:contentDescription="@string/tetotv_player_fast_forward"
                            android:nextFocusLeft="@id/exo_play_pause"
                            android:nextFocusRight="@id/tetotv_audio_tracks"
                            android:paddingStart="11dp"
                            android:paddingEnd="11dp"
                            android:src="@drawable/tetotv_ic_forward_rounded" />
                    </LinearLayout>
                </LinearLayout>

                <Space
                    android:layout_width="18dp"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:id="@id/exo_basic_controls"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:clipChildren="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/tetotv_audio_control"
                        style="@style/TetoTVPlayerControlPill"
                        android:addStatesFromChildren="true">

                        <ImageButton
                            android:id="@+id/tetotv_audio_tracks"
                            style="@style/TetoTVPlayerControlIcon"
                            android:contentDescription="@string/tetotv_player_audio_tracks"
                            android:nextFocusLeft="@id/exo_ffwd"
                            android:nextFocusRight="@id/tetotv_caption_tracks"
                            android:src="@drawable/tetotv_ic_audio_track" />

                        <TextView
                            style="@style/TetoTVPlayerControlLabel"
                            android:text="@string/tetotv_player_audio_short" />
                    </LinearLayout>

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:id="@+id/tetotv_caption_control"
                        style="@style/TetoTVPlayerControlPill"
                        android:addStatesFromChildren="true">

                        <ImageButton
                            android:id="@+id/tetotv_caption_tracks"
                            style="@style/TetoTVPlayerControlIcon"
                            android:contentDescription="@string/tetotv_player_closed_captions"
                            android:nextFocusLeft="@id/tetotv_audio_tracks"
                            android:nextFocusRight="@id/tetotv_caption_size"
                            android:src="@drawable/tetotv_ic_subtitle_on" />

                        <TextView
                            style="@style/TetoTVPlayerControlLabel"
                            android:text="@string/tetotv_player_cc_short" />
                    </LinearLayout>

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:id="@+id/tetotv_caption_size_control"
                        style="@style/TetoTVPlayerControlPill"
                        android:addStatesFromChildren="true">

                        <ImageButton
                            android:id="@+id/tetotv_caption_size"
                            style="@style/TetoTVPlayerControlIcon"
                            android:contentDescription="@string/tetotv_player_caption_size"
                            android:nextFocusLeft="@id/tetotv_caption_tracks"
                            android:nextFocusRight="@id/tetotv_picture_mode"
                            android:src="@drawable/tetotv_ic_caption_size" />

                        <TextView
                            style="@style/TetoTVPlayerControlLabel"
                            android:text="@string/tetotv_player_size_short" />
                    </LinearLayout>

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:id="@+id/tetotv_picture_control"
                        style="@style/TetoTVPlayerControlPill"
                        android:addStatesFromChildren="true">

                        <ImageButton
                            android:id="@+id/tetotv_picture_mode"
                            style="@style/TetoTVPlayerControlIcon"
                            android:contentDescription="@string/tetotv_player_picture"
                            android:nextFocusLeft="@id/tetotv_caption_size"
                            android:nextFocusRight="@id/tetotv_fix_video"
                            android:src="@drawable/tetotv_ic_picture" />

                        <TextView
                            style="@style/TetoTVPlayerControlLabel"
                            android:text="@string/tetotv_player_picture_short" />
                    </LinearLayout>

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:id="@+id/tetotv_player_control"
                        style="@style/TetoTVPlayerControlPill"
                        android:addStatesFromChildren="true">

                        <ImageButton
                            android:id="@+id/tetotv_fix_video"
                            style="@style/TetoTVPlayerControlIcon"
                            android:contentDescription="@string/tetotv_player_fix_video"
                            android:nextFocusLeft="@id/tetotv_picture_mode"
                            android:nextFocusRight="@id/tetotv_player_sources"
                            android:src="@drawable/tetotv_ic_player" />

                        <TextView
                            style="@style/TetoTVPlayerControlLabel"
                            android:text="@string/tetotv_player_fix_short" />
                    </LinearLayout>

                    <Space
                        android:id="@+id/tetotv_sources_spacing"
                        android:layout_width="8dp"
                        android:layout_height="1dp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/tetotv_sources_control"
                        style="@style/TetoTVPlayerControlPill"
                        android:addStatesFromChildren="true"
                        android:visibility="gone">

                        <ImageButton
                            android:id="@+id/tetotv_player_sources"
                            style="@style/TetoTVPlayerControlIcon"
                            android:contentDescription="@string/tetotv_player_sources"
                            android:nextFocusLeft="@id/tetotv_fix_video"
                            android:nextFocusRight="@id/tetotv_player_options"
                            android:src="@drawable/tetotv_ic_sources" />

                        <TextView
                            style="@style/TetoTVPlayerControlLabel"
                            android:text="@string/tetotv_player_sources_short" />
                    </LinearLayout>

                    <Space
                        android:layout_width="18dp"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:id="@+id/tetotv_options_control"
                        style="@style/TetoTVPlayerControlPill"
                        android:addStatesFromChildren="true">

                        <ImageButton
                            android:id="@+id/tetotv_player_options"
                            style="@style/TetoTVPlayerControlIcon"
                            android:contentDescription="@string/tetotv_player_options"
                            android:nextFocusLeft="@id/tetotv_player_sources"
                            android:src="@drawable/tetotv_ic_options" />

                        <TextView
                            style="@style/TetoTVPlayerControlLabel"
                            android:text="@string/tetotv_player_options_short" />
                    </LinearLayout>

                    <Space
                        android:layout_width="20dp"
                        android:layout_height="1dp" />
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Keep the progress bar visibly separate from the action row. -->
        <androidx.media3.ui.DefaultTimeBar
            android:id="@id/exo_progress"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="@dimen/tetotv_player_progress_touch_margin_top"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="no"
            android:longClickable="false"
            app:bar_height="@dimen/tetotv_player_progress_bar_height"
            app:buffered_color="#3DFFFFFF"
            app:played_color="#FFFF496A"
            app:scrubber_color="@android:color/transparent"
            app:scrubber_disabled_size="0dp"
            app:scrubber_dragged_size="0dp"
            app:scrubber_enabled_size="0dp"
            app:touch_target_height="32dp"
            app:unplayed_color="#3DFFFFFF" />

        <LinearLayout
            android:id="@+id/tetotv_time_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tetotv_player_time_footer_margin_top"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@id/exo_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:importantForAccessibility="noHideDescendants"
                android:orientation="horizontal">

                <TextView
                    android:id="@id/exo_position"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:text="@string/tetotv_player_time_separator"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@id/exo_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tetotv_footer_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:text="@string/tetotv_player_footer_hint"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:textColor="#FFB7AEB1"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Media3 treats these groups as optional responsive-control regions. -->
    <LinearLayout
        android:id="@id/exo_minimal_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:orientation="horizontal"
        android:visibility="gone" />

    <LinearLayout
        android:id="@id/exo_top_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:orientation="horizontal"
        android:visibility="gone" />

    <HorizontalScrollView
        android:id="@id/exo_extra_controls_scroll_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:visibility="gone">

        <LinearLayout
            android:id="@id/exo_extra_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageButton
                android:id="@id/exo_overflow_hide"
                style="@style/TetoTVPlayerControlIcon"
                android:contentDescription="@string/tetotv_player_hide_more_controls"
                android:visibility="gone" />
        </LinearLayout>
    </HorizontalScrollView>

    <ImageButton
        android:id="@id/exo_overflow_show"
        style="@style/TetoTVPlayerControlIcon"
        android:layout_gravity="bottom|end"
        android:contentDescription="@string/tetotv_player_show_more_controls"
        android:visibility="gone" />
</merge>
