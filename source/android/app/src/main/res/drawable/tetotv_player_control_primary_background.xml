<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <layer-list>
            <!-- Keep primary red controls distinct with a dark inner keyline. -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#99FF365C" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
            <item
                android:bottom="1dp"
                android:left="1dp"
                android:right="1dp"
                android:top="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FFE52B50" />
                    <corners android:radius="7dp" />
                    <stroke
                        android:width="3dp"
                        android:color="#FFFF5C78" />
                </shape>
            </item>
            <item
                android:bottom="4dp"
                android:left="4dp"
                android:right="4dp"
                android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FFE52B50" />
                    <corners android:radius="4dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#E6000000" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFC52343" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFE52B50" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
